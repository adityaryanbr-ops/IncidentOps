# Required for live Nebius + Tavily analyses
NEBIUS_API_KEY=your_nebius_token_factory_key
TAVILY_API_KEY=your_tavily_api_key

# Optional overrides
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
TEXT_MODEL=nvidia/Nemotron-3_5-Lightning
CORS_ORIGINS=http://localhost:3847,http://127.0.0.1:3847
ALLOW_DEMO_MODE=true
FORCE_DEMO_MODE=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8765
